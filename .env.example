# --- Base de dades (PostgreSQL) ---
# Local: postgresql://user:password@localhost:5432/dictatsia
# Neon / Supabase: cadena de connexio proporcionada pel proveidor
DATABASE_URL="postgresql://user:password@localhost:5432/dictatsia"

# --- NextAuth ---
# Genera amb: npx auth secret
AUTH_SECRET="changeme"
# Nomes cal en producció (o si el port de dev no és el 3000 per defecte).
# En desenvolupament, Auth.js detecta l'host automaticament si es deixa buit.
# AUTH_URL="https://el-teu-domini.cat"

# ATENCIO: l'acces de prova deixa entrar amb QUALSEVOL correu i triant
# qualsevol rol, incloent SUPERADMIN, sense contrasenya. En desenvolupament
# s'activa sol quan no hi ha SSO; en un desplegament public cal posar-hi
# explicitament "true" i NOMES mentre no hi hagi dades reals d'alumnat.
# ALLOW_DEMO_LOGIN="true"

# Google SSO (Google Cloud Console > OAuth 2.0 Client IDs)
# URI de redirecció autoritzat: https://EL-TEU-DOMINI/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Amb SSO actiu només poden entrar els correus d'un centre registrat o els
# usuaris ja donats d'alta. Aquests dominis hi poden entrar sempre (equip que
# administra la plataforma). Separats per comes.
AUTH_ALLOWED_DOMAINS=""

# Deixa entrar qui vulgui preparar-se pel seu compte (C1, C2...) amb el seu
# correu, sense pertanyer a cap centre. Entra sense escola ni grup classe, aixi
# que no veu dades de cap centre. Posa-hi "false" per a un desplegament que
# nomes hagi de servir escoles.
AUTH_ALLOW_SELF_LEARNERS="true"

# Microsoft Entra ID / Azure AD SSO
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
AUTH_MICROSOFT_ENTRA_ID_ISSUER="https://login.microsoftonline.com/common/v2.0"

# --- Anthropic Claude (generacio de dictats + avaluacio OCR) ---
# Si no es defineix, l'API fa servir respostes simulades (mock)
ANTHROPIC_API_KEY=""

# --- Google Cloud Vision (OCR de fotos manuscrites) ---
# Si no es defineix, l'API fa servir OCR simulat (mock)
GOOGLE_CLOUD_VISION_API_KEY=""

# --- Gemini TTS (locució dels dictats, servei principal de veu) ---
# La clau NOMÉS es fa servir al servidor: mai arriba al navegador.
# A Gemini només s'hi envia el text del dictat, cap dada personal de l'alumnat.
# Si no es defineix, es prova OpenAI i, si tampoc, la veu del navegador.
GEMINI_API_KEY=""
# Opcionals: veu i model. Gemini admet català (codi "ca").
GEMINI_TTS_VOICE="Kore"
GEMINI_TTS_MODEL="gemini-2.5-flash-preview-tts"

# --- OpenAI TTS (alternativa de locució) ---
# Si no es defineix, no es genera àudio real (s'usa la veu del navegador)
OPENAI_API_KEY=""
