// DictatsIA - Multi-tenant schema
// Generator & datasource

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  SUPERADMIN
  SCHOOL_COORD
  TEACHER
  STUDENT
}

enum PlanType {
  AULA
  ESCOLA
  XARXA
}

enum SubmissionStatus {
  PENDING
  OCR_PROCESSING
  OCR_FAILED
  AI_EVALUATING
  EVALUATED
  REVIEWED
}

enum InputMethod {
  PHOTO
  KEYBOARD
}

// ---------------------------------------------------------------------------
// Tenant
// ---------------------------------------------------------------------------

model School {
  id              String   @id @default(cuid())
  name            String
  domain          String   @unique
  customSubdomain String?  @unique
  logo            String?
  planType        PlanType @default(AULA)
  neePresets      Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  users       User[]
  classGroups ClassGroup[]

  @@index([domain])
}

// ---------------------------------------------------------------------------
// Identity (NextAuth compatible)
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  role          Role      @default(STUDENT)
  needsProfile  Json?

  schoolId String?
  school   School? @relation(fields: [schoolId], references: [id], onDelete: SetNull)

  classGroupId String?
  classGroup   ClassGroup? @relation("StudentsInClass", fields: [classGroupId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts Account[]
  sessions Session[]

  skillStates            StudentSkillState[] @relation("StudentSkills")
  taughtClassGroups      ClassGroup[]        @relation("TeacherOfClass")
  teacherOverrides       TeacherOverride[]   @relation("OverridesByTeacher")
  dictationsCreated      Dictation[]         @relation("DictationTeacher")
  personalisedDictations Dictation[]         @relation("PersonalisedDictations")
  submissions            Submission[]        @relation("StudentSubmissions")
  improvementReports     ImprovementReport[] @relation("StudentReports")

  @@index([schoolId])
  @@index([classGroupId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Academic structure
// ---------------------------------------------------------------------------

model ClassGroup {
  id         String @id @default(cuid())
  name       String
  gradeLevel String

  // Codi curt que el docent comparteix amb la classe perquè l'alumnat s'hi
  // apunti sol, en lloc d'haver-los d'assignar un per un.
  joinCode String? @unique

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  teacherId String?
  teacher   User?   @relation("TeacherOfClass", fields: [teacherId], references: [id], onDelete: SetNull)

  students   User[]      @relation("StudentsInClass")
  dictations Dictation[]

  createdAt DateTime @default(now())

  @@index([schoolId])
  @@index([teacherId])
}

// ---------------------------------------------------------------------------
// Dictation content & submissions
// ---------------------------------------------------------------------------

model Dictation {
  id             String  @id @default(cuid())
  title          String
  targetRule     String
  // Habilitat concreta dins de la regla ("accentuacio.agudes"). Quan hi es, es
  // ella qui rep el resultat del dictat; si no, el rep la regla sencera.
  targetSubskill String?
  gradeLevel     String
  rawText        String  @db.Text
  // El docent ha demanat locucio generada per a aquest dictat. L'audio en si
  // no viu aqui: veure DictationAudio.
  wantsAudio     Boolean @default(false)
  // Quin servei ha locutat el dictat l'ultim cop: "gemini", "openai" o
  // "browser" (veu del navegador, quan cap servei estava disponible).
  audioSource    String?
  isAIGenerated  Boolean @default(true)

  // Com vol el docent que l'alumne escolti aquest dictat:
  // { defaultSpeed: number, maxRepetitions: number|null, forceHiddenScreen: boolean }
  playbackSettings Json?

  teacherId String
  teacher   User   @relation("DictationTeacher", fields: [teacherId], references: [id], onDelete: Cascade)

  classGroupId String?
  classGroup   ClassGroup? @relation(fields: [classGroupId], references: [id], onDelete: SetNull)

  // Quan s'omple, el dictat es personalitzat per a aquest alumne concret
  // (generat a partir del seu historial d'errors) en lloc de ser per a tot el grup.
  targetStudentId String?
  targetStudent   User?   @relation("PersonalisedDictations", fields: [targetStudentId], references: [id], onDelete: Cascade)

  submissions Submission[]
  audio       DictationAudio?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teacherId])
  @@index([classGroupId])
  @@index([targetStudentId])
}

/// Locucio generada d'un dictat.
///
/// Viu en una taula a part i no dins de Dictation a proposit: un minut i mig
/// de veu son uns quants megues, i si estigues a la taula principal cada
/// llistat de dictats se'ls emportaria tots a memoria per ensenyar nomes els
/// titols. Aqui nomes es llegeix quan algu prem "Escoltar".
///
/// Es cache, no dada: sempre es pot tornar a generar a partir de rawText, aixi
/// que es pot esborrar per alliberar espai (scripts/prune-dictation-audio.mjs).
model DictationAudio {
  dictationId String    @id
  dictation   Dictation @relation(fields: [dictationId], references: [id], onDelete: Cascade)

  // Binari, no base64: el base64 ocupa un 33% mes per a la mateixa veu.
  data     Bytes
  mimeType String
  source   String

  createdAt  DateTime @default(now())
  // Ultim cop que algu la va escoltar, per saber que es pot esborrar.
  lastUsedAt DateTime @default(now())

  @@index([lastUsedAt])
}

model Submission {
  id          String    @id @default(cuid())
  dictationId String
  dictation   Dictation @relation(fields: [dictationId], references: [id], onDelete: Cascade)

  studentId String
  student   User   @relation("StudentSubmissions", fields: [studentId], references: [id], onDelete: Cascade)

  photoUrl      String?
  // Text de l'alumne: transcrit per OCR si ve d'una foto, o escrit directament
  // amb el teclat. `inputMethod` diu d'on ve.
  ocrText       String?          @db.Text
  inputMethod   InputMethod      @default(PHOTO)
  correctedData Json?
  score         Float?
  status        SubmissionStatus @default(PENDING)

  overrides TeacherOverride[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dictationId])
  @@index([studentId])
}

/// Que domina un alumne de cada habilitat ortografica, i com de segurs n'estem.
///
/// Es podria recalcular sempre des de zero llegint tot l'historial, com es feia
/// fins ara, pero llavors el motor adaptatiu no pot saber res que no es
/// dedueixi de les puntuacions: ni quant fa que no es practica una habilitat,
/// ni amb quina versio de l'algorisme es va mesurar. Aixo es aquella foto,
/// desada i datada.
model StudentSkillState {
  id String @id @default(cuid())

  studentId String
  student   User   @relation("StudentSkills", fields: [studentId], references: [id], onDelete: Cascade)

  /// Clau de la taxonomia: "accentuacio" o "accentuacio.agudes".
  skill String

  /// Que en domina, de 0 a 1.
  mastery    Float @default(0)
  /// Com de fiable es aquesta mesura: puja amb evidencia recent i repetida.
  confidence Float @default(0)

  attempts Int @default(0)
  errors   Int @default(0)

  lastPracticedAt DateTime?

  /// Amb quines regles es va calcular, per poder recalcular-ho tot el dia que
  /// canviin sense confondre mesures velles amb noves.
  algorithmVersion Int @default(1)
  taxonomyVersion  Int @default(1)

  updatedAt DateTime @updatedAt

  @@unique([studentId, skill])
  @@index([studentId])
}

/// Un docent que esmena una classificacio de la IA.
///
/// L'esmena s'aplica de seguida sobre la correccio desada, aixi que aquesta
/// taula no cal per fer-la efectiva: hi es perque quedi constancia de qui va
/// canviar que i per que. Sense aixo, d'aqui a un any ningu no sabria si una
/// correccio la va decidir el model o una persona.
model TeacherOverride {
  id String @id @default(cuid())

  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  teacherId String
  teacher   User   @relation("OverridesByTeacher", fields: [teacherId], references: [id], onDelete: Cascade)

  /// Posicio de l'errada dins de correctedData.errors.
  errorIndex Int

  /// "invalidar" (no era cap errada) o "reclassificar" (era d'una altra regla).
  action String

  /// Habilitat correcta, quan l'accio es reclassificar.
  newSkill String?

  /// Que hi havia abans, per poder desfer-ho i per saber que va canviar.
  previousSkill String?

  /// Per que ho canvia. Obligatori: una esmena sense motiu no s'enten despres.
  reason String @db.Text

  createdAt DateTime @default(now())

  @@index([submissionId])
  @@index([teacherId])
}

model ImprovementReport {
  id        String @id @default(cuid())
  studentId String
  student   User   @relation("StudentReports", fields: [studentId], references: [id], onDelete: Cascade)

  summaryText     String @db.Text
  weaknessMetrics Json

  createdAt DateTime @default(now())

  @@index([studentId])
}
